amends "package://github.com/jdx/hk/releases/download/v1.45.0/hk@1.45.0#/Config.pkl"

exclude = List("raw/**")

hooks {
  ["pre-commit"] {
    steps {
      ["lint-md"] {
        glob = List("**/*.md", ".markdownlint-cli2.yaml", "justfile", ".mise.toml", "hk.pkl")
        check = "just lint-md"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["lint-commit"] {
        check = "just lint-commit \"{{commit_msg_file}}\""
      }
    }
  }
}
