{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6-astra",
  "steeringMode": "all",
  "terminal": {
    "images": "kitty"
  },
  "packages": [
    "npm:pi-live-codex",
    {
      "source": "npm:pi-subagents@0.77.0",
      "skills": [],
      "prompts": []
    },
    {
      "source": "git:github.com/waldoibarra/pi-lens@v0.2.0",
      "skills": [],
      "prompts": []
    }
  ],
  "compaction": {
    "enabled": true,
    "modelOverrides": {
      "openai-codex/gpt-5.5": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-5.6-luna": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-5.6-sol": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-5.6-terra": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-6-astra": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-6-luna": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-6-sol": {
        "reserveTokens": 128000
      },
      "openai-codex/gpt-6.1-sol": {
        "reserveTokens": 128000
      }
    }
  },
  "subagents": {
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openai-codex/gpt-5.5",
        "openai-codex/gpt-5.6-luna",
        "openai-codex/gpt-5.6-sol",
        "openai-codex/gpt-5.6-terra",
        "openai-codex/gpt-6-luna",
        "openai-codex/gpt-6-sol",
        "openai-codex/gpt-6.1-sol"
      ]
    },
    "agentScanDirs": ["~/.agents/roles"],
    "disableBuiltins": true,
    "defaultExtensions": [],
    "agentOverrides": {
      "plan-reviewer": {
        "systemPromptMode": "append",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "advertise": true,
        "tools": ["read", "grep", "find", "ls", "bash"]
      },
      "code-auditor": {
        "systemPromptMode": "append",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "advertise": true,
        "tools": ["read", "grep", "find", "ls", "bash"]
      },
      "browser-tester": {
        "systemPromptMode": "append",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "advertise": true
      },
      "docs-writer": {
        "systemPromptMode": "append",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "advertise": true
      },
      "implementer": {
        "systemPromptMode": "append",
        "inheritProjectContext": true,
        "inheritGlobalContext": true,
        "inheritSkills": true,
        "advertise": true
      }
    }
